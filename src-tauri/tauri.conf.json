{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FABricator",
  "version": "0.1.0",
  "identifier": "com.fabricator.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FABricator",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "../LICENSE",
    "fileAssociations": [
      {
        "ext": ["fab"],
        "name": "FABricator Project",
        "role": "Editor",
        "mimeType": "application/x-fabricator"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "both",
        "languages": ["Italian", "English"],
        "displayLanguageSelector": true
      }
    }
  }
}
